<!-- views/register.ejs -->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header class="main-header">
            <div class="title-section">
                <h1>Kelola & Registrasi Siswa</h1>
                <p>Tambah siswa baru atau lihat daftar siswa yang sudah terdaftar.</p>
            </div>
            <a href="/" class="btn btn-secondary">← Kembali ke Dashboard</a>
        </header>

        <main class="register-content">

            <!-- ===== Form Registrasi ===== -->
            <div class="form-section">
                <h2>Tambah Siswa Baru</h2>
                <form id="manual-register-form">
                    <div class="form-group">
                        <label for="reg-uid">UID Kartu RFID</label>
                        <input type="text" id="reg-uid" name="uid" required placeholder="Contoh: 1a2b3c4d">
                    </div>
                    <div class="form-group">
                        <label for="reg-name">Nama Siswa</label>
                        <input type="text" id="reg-name" name="name" required placeholder="Masukkan nama lengkap siswa">
                    </div>
                    <div class="form-group">
                        <label for="reg-student-id">ID Siswa (NIS)</label>
                        <input type="text" id="reg-student-id" name="studentId" required placeholder="Masukkan ID unik siswa">
                    </div>
                    <div class="form-group">
                        <label>Jenis Kelamin</label>
                        <div class="gender-options">
                            <div class="gender-option">
                                <input type="radio" id="manual-gender-male" name="gender" value="Laki-laki" required>
                                <label for="manual-gender-male">Laki-laki</label>
                            </div>
                            <div class="gender-option">
                                <input type="radio" id="manual-gender-female" name="gender" value="Perempuan" required>
                                <label for="manual-gender-female">Perempuan</label>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" style="width:100%; padding: 13px;">
                        Daftarkan Siswa
                    </button>
                    <div id="response-message"></div>
                </form>
            </div>

            <!-- ===== Tabel Siswa Terdaftar (dengan scroll) ===== -->
            <aside class="student-list-section">
                <h2>
                    Siswa Terdaftar
                    <span style="font-size:13px; font-weight:500; color:var(--text-secondary);">
                        (<%= students.length %> siswa)
                    </span>
                </h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th style="width:40px; text-align:center;">#</th>
                                <th>Nama</th>
                                <th>NIS / NISN</th>
                                <th>UID Kartu</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (students.length > 0) { %>
                                <% students.forEach((student, index) => { %>
                                    <tr>
                                        <td style="text-align:center; color:var(--text-secondary); font-weight:600;">
                                            <%= index + 1 %>
                                        </td>
                                        <td style="font-weight:600;"><%= student.name %></td>
                                        <td style="color:var(--text-secondary);"><%= student.studentId %></td>
                                        <td>
                                            <code style="
                                                background: var(--input-bg);
                                                padding: 3px 8px;
                                                border-radius: 6px;
                                                font-size: 12px;
                                                color: var(--color-info);
                                                border: 1px solid var(--border-color);
                                            "><%= student.uid %></code>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" style="text-align:center; padding: 40px; color: var(--text-secondary); font-style: italic;">
                                        Belum ada siswa yang terdaftar.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </aside>

        </main>
    </div>

    <script>
        const form = document.getElementById('manual-register-form');
        const messageDiv = document.getElementById('response-message');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = Object.fromEntries(new FormData(form).entries());

            messageDiv.textContent = '⏳ Mendaftarkan siswa...';
            messageDiv.className = 'loading';

            try {
                const response = await fetch('/api/students', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                });
                const result = await response.json();

                if (response.ok) {
                    messageDiv.textContent = `✅ Berhasil! "${result.data.name}" telah didaftarkan. Memuat ulang...`;
                    messageDiv.className = 'success';
                    form.reset();
                    setTimeout(() => window.location.reload(), 2000);
                } else {
                    messageDiv.textContent = `❌ Gagal: ${result.message}`;
                    messageDiv.className = 'error';
                }
            } catch (error) {
                messageDiv.textContent = '❌ Terjadi kesalahan koneksi.';
                messageDiv.className = 'error';
            }
        });
    </script>
</body>
</html>
