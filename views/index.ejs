<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<!-- SIMPAN TANGGAL DARI SERVER DI SINI -->
<body data-current-date="<%= currentDate %>">

    <div class="container">
        <header class="main-header">
            <div class="title-section">
                <h1>ABSENSI SISWA KELAS 6</h1>
                <p id="current-date">Memuat tanggal...</p>
            </div>
            
            <div class="header-controls">
                <!-- PEMILIH TANGGAL DIPINDAH KE SINI AGAR RAPI -->
                <div class="date-picker-wrapper">
                    <label for="date-picker">Tampilkan Tanggal:</label>
                    <input type="date" id="date-picker">
                </div>
                
                <div class="user-controls">
                    <div class="registration-controls">
                        <span>Mode Reg: <b id="reg-status">OFF</b></span>
                        <button id="toggle-reg-mode" class="btn btn-secondary">Aktifkan</button>
                    </div>
                    <div class="user-info">
                        <% if (user) { %>
                            <span>Hi, <strong><%= user.username %></strong>!</span>
                            <button id="logout-button" class="btn btn-logout">Logout</button>
                        <% } else { %>
                            <a href="/login" class="btn btn-logout">Login</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </header>

        <div class="content-wrapper">
            <main class="attendance-main">
                <h2 id="attendance-title">Kehadiran</h2>
                <div class="table-container">
                    <table id="attendance-table">
                        <thead>
                            <tr>
                                <th>NO</th>
                                <th>NAMA</th>
                                <th>NIS</th>
                                <th>WAKTU</th>
                                <th>STATUS</th>
                                <th>FOTO</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dibiarkan kosong, akan diisi oleh dashboard.js -->
                            <tr id="no-data"><td colspan="6" style="text-align:center;">Memuat data absensi...</td></tr>
                        </tbody>
                    </table>
                </div>
            </main>
            
            <aside class="manual-attendance-section">
                <h2>Absensi Manual</h2>
                <p id="manual-attendance-subtitle">Siswa yang belum tercatat kehadirannya.</p>
                <ul id="absent-student-list">
                    <!-- Dibiarkan kosong, akan diisi oleh dashboard.js -->
                    <li class="loading">Memuat daftar siswa...</li>
                </ul>
            </aside>
        </div>

        <footer class="actions-footer">
            <a href="/register" class="btn btn-footer">Kelola Siswa</a>
            <a href="/reports" class="btn btn-footer">Laporan</a>
            <button id="export-button" class="btn btn-export">Export Data Terpilih</button>
        </footer>
    </div>

    <!-- Modal Registrasi (tidak berubah, tetap di luar .container) -->
    <div id="registration-modal" class="modal-overlay"> 
        <div class="modal-content">
            <h2>Registrasi Kartu Baru</h2>
            <p>Tap kartu baru terdeteksi! Silakan lengkapi data di bawah ini.</p>
            <form id="registration-form">
                <div class="form-group">
                    <label for="reg-uid">UID Kartu:</label>
                    <input type="text" id="reg-uid" name="uid" readonly>
                </div>
                <div class="form-group">
                    <label for="reg-name">Nama Siswa:</label>
                    <input type="text" id="reg-name" name="name" required placeholder="Masukkan nama lengkap...">
                </div>
                <div class="form-group">
                    <label for="reg-student-id">ID Siswa (NISN):</label>
                    <input type="text" id="reg-student-id" name="studentId" required placeholder="Masukkan ID siswa...">
                </div>
                <div class="form-group">
                    <label>Jenis Kelamin:</label>
                    <div class="gender-options">
                        <div class="gender-option">
                            <input type="radio" id="reg-gender-male" name="gender" value="Laki-laki" required>
                            <label for="reg-gender-male">Laki-laki</label>
                        </div>
                        <div class="gender-option">
                            <input type="radio" id="reg-gender-female" name="gender" value="Perempuan" required>
                            <label for="reg-gender-female">Perempuan</label>
                        </div>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" id="cancel-reg-button" class="btn btn-footer">Batal</button>
                    <button type="submit" class="btn btn-export">Simpan Pendaftaran</button>
                </div>
            </form>
        </div>
    </div>
    
    <script src="/js/dashboard.js"></script>
</body>
</html>